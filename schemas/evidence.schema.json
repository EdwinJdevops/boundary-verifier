{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boundary-verifier.dev/schemas/evidence.schema.json",
  "title": "Boundary Verifier Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "scenario", "status", "observed_at", "edges"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "scenario": {"type": "string", "minLength": 1},
    "status": {
      "enum": ["OBSERVED_REACHABLE", "OBSERVED_BLOCKED", "UNKNOWN", "NOT_EVALUATED"]
    },
    "observed_at": {"type": "string", "format": "date-time"},
    "canary_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "relation", "to", "evidence"],
        "properties": {
          "from": {"type": "string"},
          "relation": {
            "enum": ["CAN_CONNECT", "CAN_WRITE", "CAN_READ", "CAN_PROXY_THROUGH"]
          },
          "to": {"type": "string"},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
