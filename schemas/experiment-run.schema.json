{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boundary-verifier.dev/schemas/experiment-run.schema.json",
  "title": "Boundary Verifier Experiment Run",
  "type": "object",
  "additionalProperties": false,
  "required": ["experiment", "results"],
  "properties": {
    "experiment": {"const": "EXP-001"},
    "results": {
